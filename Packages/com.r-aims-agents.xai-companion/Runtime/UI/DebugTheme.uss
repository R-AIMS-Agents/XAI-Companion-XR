:root {
    --dbg-bg: rgba(21, 23, 27, 0.88);
    --dbg-surface: rgb(30, 32, 37);
    --dbg-raised: rgb(42, 45, 51);
    --dbg-raised-hover: rgb(54, 58, 65);
    --dbg-border: rgba(255, 255, 255, 0.14);
    --dbg-border-faint: rgba(255, 255, 255, 0.1);
    --dbg-text: rgb(230, 232, 235);
    --dbg-text-dim: rgb(154, 160, 166);
    --dbg-accent: rgb(25, 118, 210);
    --dbg-off: rgb(95, 99, 104);
    --dbg-ok: rgb(76, 195, 138);
    --dbg-warn: rgb(242, 184, 75);
    --dbg-error: rgb(242, 109, 109);
    --dbg-user: rgb(130, 200, 255);
    --dbg-font-s: 16px;
    --dbg-font-m: 18px;
    --dbg-font-l: 20px;
    --dbg-font-xl: 26px;
}

.dbg-mono {
    -unity-font-definition: url("project://database/Packages/com.r-aims-agents.xai-companion/Runtime/UI/Fonts/JetBrainsMono-Regular.ttf?fileID=12800000&guid=3a305076ecab24a44a6a7b0bd9d9a1ea&type=3#JetBrainsMono-Regular");
}

.dbg-panel {
    width: 800px;
    flex-grow: 1;
    padding: 20px;
    border-radius: 16px;
    background-color: var(--dbg-bg);
    color: var(--dbg-text);
    font-size: var(--dbg-font-m);
}

.dbg-row {
    flex-direction: row;
    align-items: center;
}

.dbg-spacer {
    flex-grow: 1;
}

.dbg-toolbar {
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
    flex-shrink: 0;
    margin-bottom: 12px;
}

.dbg-footer {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-top: 12px;
}

.dbg-section {
    flex-shrink: 0;
    margin-bottom: 18px;
    flex-grow: 0;
    flex-direction: column;
}

.dbg-section-title {
    margin: 0 0 10px 0;
    padding: 0;
    font-size: var(--dbg-font-s);
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    color: var(--dbg-text-dim);
}

.dbg-label-dim {
    margin: 0;
    padding: 0;
    font-size: var(--dbg-font-s);
    color: var(--dbg-text-dim);
}

.dbg-tabs {
    flex-grow: 1;
}

.dbg-tabs > .unity-tab-view__content-viewport {
    flex-grow: 0;
    flex-shrink: 0;
}

.dbg-tabs--top > .unity-tab-view__content-viewport {
    justify-content: flex-end;
}

.dbg-tabs > .unity-tab-view__content-viewport > .unity-tab-view__header-container {
    flex-direction: row;
    flex-shrink: 0;
    padding: 3px 1px;
    border-radius: 12px;
    background-color: var(--dbg-surface);
}

.dbg-tabs--top > .unity-tab-view__content-viewport > .unity-tab-view__header-container {
    margin-bottom: 12px;
}

.dbg-tabs--inner > .unity-tab-view__content-viewport > .unity-tab-view__header-container {
    margin-bottom: 10px;
}

.dbg-tabs .unity-tab__header {
    min-height: 48px;
    padding: 0 16px;
    margin: 0 2px;
    border-radius: 8px;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0);
}

.dbg-tabs--top .unity-tab__header {
    width: 150px;
}

.dbg-tabs--inner .unity-tab__header {
    width: auto;
}

.dbg-tabs .unity-tab__header:hover {
    background-color: var(--dbg-raised);
}

.dbg-tabs .unity-tab__header:checked {
    background-color: var(--dbg-raised);
}

.dbg-tabs .unity-tab__header-label {
    margin: 0;
    padding: 0;
    font-size: var(--dbg-font-m);
    -unity-font-style: bold;
    color: var(--dbg-text-dim);
}

.dbg-tabs .unity-tab__header:checked .unity-tab__header-label {
    color: var(--dbg-text);
}

.dbg-tabs .unity-tab__header-underline {
    display: none;
}

.dbg-tabs .unity-tab-view__content-container,
.dbg-tabs .unity-tab,
.dbg-tabs .unity-tab__content-container {
    flex-grow: 1;
}

.dbg-chip {
    flex-direction: row;
    align-items: center;
    height: 40px;
    padding: 0 12px;
    margin-right: 6px;
    border-radius: 20px;
    border-width: 1px;
    border-color: var(--dbg-border-faint);
    background-color: var(--dbg-surface);
}

.dbg-chip__dot {
    width: 12px;
    height: 12px;
    margin-right: 8px;
    border-radius: 6px;
    background-color: var(--dbg-off);
}

.dbg-chip__label {
    margin: 0;
    padding: 0;
    font-size: var(--dbg-font-s);
    color: var(--dbg-text-dim);
}

.dbg-chip--large .dbg-chip__label {
    font-size: var(--dbg-font-m);
}

.dbg-chip--ok .dbg-chip__dot {
    background-color: var(--dbg-ok);
}

.dbg-chip--error .dbg-chip__dot {
    background-color: var(--dbg-error);
}

.dbg-chip--ok .dbg-chip__label,
.dbg-chip--error .dbg-chip__label {
    color: var(--dbg-text);
}

.dbg-button {
    height: 48px;
    padding: 0 16px;
    margin: 0 0 0 6px;
    border-radius: 8px;
    border-width: 1px;
    border-color: var(--dbg-border);
    background-color: var(--dbg-raised);
    color: var(--dbg-text);
    font-size: var(--dbg-font-m);
}

.dbg-button:hover {
    background-color: var(--dbg-raised-hover);
}

.dbg-button--danger {
    margin-left: 0;
    border-color: var(--dbg-error);
    background-color: rgba(0, 0, 0, 0);
    color: var(--dbg-error);
}

.dbg-button--danger:hover {
    background-color: rgba(242, 109, 109, 0.12);
}

.dbg-button:disabled {
    opacity: 0.4;
}

.dbg-toggle {
    height: 48px;
    padding: 0 16px;
    margin: 0 0 0 6px;
    border-radius: 24px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.18);
    background-color: rgba(0, 0, 0, 0);
}

.dbg-toggle:checked {
    border-color: var(--dbg-accent);
    background-color: var(--dbg-accent);
}

.dbg-toggle .unity-toggle__input {
    flex-grow: 1;
    align-items: center;
}

.dbg-toggle #unity-checkmark {
    width: 10px;
    height: 10px;
    min-width: 10px;
    min-height: 10px;
    border-width: 0;
    border-radius: 5px;
    background-image: none;
    background-color: var(--dbg-off);
}

.dbg-toggle--log:checked #unity-checkmark {
    background-color: var(--dbg-text-dim);
}

.dbg-toggle--warn:checked #unity-checkmark {
    background-color: var(--dbg-warn);
}

.dbg-toggle--error:checked #unity-checkmark {
    background-color: var(--dbg-error);
}

.dbg-toggle .unity-toggle__text {
    margin: 0 0 0 8px;
    padding: 0;
    font-size: var(--dbg-font-m);
    color: var(--dbg-text-dim);
}

.dbg-toggle:checked .unity-toggle__text {
    color: rgb(255, 255, 255);
}

.dbg-dropdown {
    margin: 0;
}

.dbg-dropdown .unity-base-field__input {
    height: 52px;
    padding: 0 12px;
    border-radius: 8px;
    border-width: 1px;
    border-color: var(--dbg-border);
    background-color: var(--dbg-surface);
}

.dbg-dropdown .unity-base-popup-field__text {
    font-size: var(--dbg-font-m);
    color: var(--dbg-text);
}

.dbg-dropdown .unity-base-popup-field__arrow {
    -unity-background-image-tint-color: var(--dbg-text-dim);
}

.dbg-meter-row {
    margin-top: 10px;
}

.dbg-meter {
    flex-grow: 1;
    margin: 0 10px;
    padding: 0;
}

.dbg-meter .unity-progress-bar__container {
    height: 12px;
    min-height: 12px;
    margin: 0;
}

.dbg-meter .unity-progress-bar__background {
    border-radius: 6px;
    border-width: 1px;
    border-color: var(--dbg-border-faint);
    background-color: var(--dbg-surface);
}

.dbg-meter .unity-progress-bar__progress {
    border-radius: 6px;
    background-color: var(--dbg-ok);
}

.dbg-meter--hot .unity-progress-bar__progress {
    background-color: var(--dbg-warn);
}

.dbg-meter .unity-progress-bar__title-container {
    display: none;
}

.dbg-meter__value {
    width: 96px;
    -unity-text-align: middle-right;
}

.dbg-list {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    padding: 6px 0;
    border-radius: 12px;
    background-color: var(--dbg-surface);
    flex-basis: 0;
}

.dbg-entry {
    flex-direction: row;
    align-items: flex-start;
    padding: 4px 12px;
    row-gap: 5px;
    column-gap: 5px;
}

.dbg-entry > .unity-label {
    margin: 0;
    padding: 0;
}

.dbg-entry__time {
    flex-shrink: 0;
    margin-right: 10px;
    font-size: var(--dbg-font-s);
    color: var(--dbg-text-dim);
    -unity-font-definition: url("project://database/Packages/com.r-aims-agents.xai-companion/Runtime/UI/Fonts/JetBrainsMono-Regular.ttf?fileID=12800000&guid=3a305076ecab24a44a6a7b0bd9d9a1ea&type=3#JetBrainsMono-Regular");
}

.dbg-entry__marker {
    display: none;
    flex-shrink: 0;
    width: 10px;
    height: 10px;
    margin: 6px 10px 0 0;
    border-radius: 5px;
    background-color: rgba(0, 0, 0, 0);
    margin-left: 10px;
}

.dbg-entry__prefix {
    flex-shrink: 0;
    margin-right: 10px;
    -unity-font-style: bold;
    margin-left: 0;
    padding-left: 0;
}

.dbg-entry__text {
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
    color: var(--dbg-text);
}

.dbg-entry--log .dbg-entry__marker,
.dbg-entry--warn .dbg-entry__marker,
.dbg-entry--error .dbg-entry__marker {
    display: flex;
}

.dbg-entry--warn .dbg-entry__marker {
    background-color: var(--dbg-warn);
}

.dbg-entry--warn .dbg-entry__text {
    color: var(--dbg-warn);
}

.dbg-entry--error .dbg-entry__marker {
    background-color: var(--dbg-error);
}

.dbg-entry--error .dbg-entry__text {
    color: var(--dbg-error);
}

.dbg-entry--user .dbg-entry__prefix,
.dbg-entry--agent .dbg-entry__prefix {
    width: 72px;
    font-size: var(--dbg-font-l);
}

.dbg-entry--user .dbg-entry__prefix {
    color: var(--dbg-user);
}

.dbg-entry--user .dbg-entry__text,
.dbg-entry--agent .dbg-entry__text {
    font-size: var(--dbg-font-l);
}

.dbg-entry--feed {
    flex-wrap: wrap;
}

.dbg-entry--feed .dbg-entry__prefix {
    -unity-font-style: normal;
    color: var(--dbg-user);
}

.dbg-entry--feed .dbg-entry__prefix,
.dbg-entry--feed .dbg-entry__text {
    font-size: var(--dbg-font-s);
    -unity-font-definition: url("project://database/Packages/com.r-aims-agents.xai-companion/Runtime/UI/Fonts/JetBrainsMono-Regular.ttf?fileID=12800000&guid=3a305076ecab24a44a6a7b0bd9d9a1ea&type=3#JetBrainsMono-Regular");
}

.dbg-entry--feed .dbg-entry__text {
    width: 100%;
    flex-shrink: 0;
    margin-top: 2px;
    color: var(--dbg-text-dim);
}
